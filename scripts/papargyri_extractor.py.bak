#!/usr/bin/env python3
"""
papargyri_extractor.py
─────────────────────────────────────────────────────────────────────────────
Converts Papargyri 2020 Table S1 (Excel) into OligoTox training rows.

USAGE:
    python scripts/papargyri_extractor.py \
        --input data/raw/papers_gated/papargyri_2020_LNA_512gapmers_TableS1.xlsx \
        --output data/curated/papargyri_512gapmers_labeled.csv

TABLE S1 EXPECTED COLUMNS (Papargyri 2020, Mol Ther Nucleic Acids 2020):
    - Sequence (16-nt gapmer sequence)
    - Design (LNA/DNA pattern, e.g. LdLdLddddddddLdL)
    - Region (A or B)
    - Knockdown (HIF1A mRNA %, 5µM unassisted uptake, mean of n=4)
    - Caspase (% of PBS control, 100nM transfection, mean of n=3)
    - Tm_delta (delta Tm vs unmodified)
    - 3mer motifs: aag, tac, etc. (0/1)

LABELING RULES (from Dieckmann 2018 threshold):
    offtarget_gene_silencing = 1  if Caspase > 300%
    offtarget_gene_silencing = 0  if Caspase <= 300%
    hepatocellular_injury    = 1  if Caspase > 500%  (severe cytotox proxy)
    hepatocellular_injury    = 0  if Caspase <= 500%
"""

import argparse
import pandas as pd
import numpy as np
import re
import sys

CASPASE_TOX_THRESHOLD = 300.0   # % of PBS — Dieckmann/Papargyri threshold
CASPASE_SEVERE_THRESHOLD = 500.0 # proxy for hepatocellular_injury

def parse_lna_design(design_str):
    """Parse LNA/DNA design string into feature counts.
    L = LNA, d = DNA, x = LNA or DNA
    Returns dict of: lna_count, lna_5prime (first 4 pos), lna_3prime (last 4 pos)
    """
    if not isinstance(design_str, str):
        return {"lna_count": 0, "lna_5prime": 0, "lna_3prime": 0}

    lna_positions = [i for i, c in enumerate(design_str.upper()) 
                     if c in ('L', 'X')]
    n = len(design_str)
    flank = min(4, n // 4)

    return {
        "lna_count": len(lna_positions),
        "lna_5prime": sum(1 for p in lna_positions if p < flank),
        "lna_3prime": sum(1 for p in lna_positions if p >= n - flank),
    }

def compute_gc(seq):
    if not seq or not isinstance(seq, str):
        return 0.0
    seq = seq.upper()
    return (seq.count('G') + seq.count('C')) / len(seq)

def compute_cpg(seq):
    if not seq or not isinstance(seq, str):
        return 0.0
    seq = seq.upper()
    return seq.count('CG') / max(len(seq) - 1, 1)

def estimate_seed_match_score(seq):
    """
    Heuristic seed-match risk: count putative miRNA seed complementarity.
    Seed = positions 2-8 of the oligo. Rough complement scoring.
    Replace with ViennaRNA/TargetScan integration for production.
    """
    if not isinstance(seq, str) or len(seq) < 8:
        return 0.0
    seed = seq[1:8].upper()
    complement = str.maketrans('ACGT', 'TGCA')
    seed_comp = seed.translate(complement)
    # score based on GC content of seed (higher = more stable off-target)
    gc = (seed_comp.count('G') + seed_comp.count('C')) / len(seed_comp)
    return round(gc * 0.8, 3)

def compute_tlr_prob(seq):
    """TLR7/8 risk from UU/GU motifs; TLR9 risk from unmethylated CG."""
    if not isinstance(seq, str):
        return 0.0
    seq = seq.upper()
    uu_count = seq.count('UU') + seq.count('TT')
    gu_count = seq.count('GU') + seq.count('GT')
    cg_count = seq.count('CG')
    score = min(1.0, (uu_count * 0.1 + gu_count * 0.08 + cg_count * 0.15))
    return round(score, 3)

def process_table_s1(df):
    """Convert Papargyri Table S1 DataFrame into OligoTox training rows."""

    # Normalize column names
    df.columns = [c.strip().lower().replace(' ', '_').replace('-', '_') 
                  for c in df.columns]

    # Identify key columns (handle naming variations)
    seq_col = next((c for c in df.columns if 'seq' in c), None)
    design_col = next((c for c in df.columns if 'design' in c), None)
    region_col = next((c for c in df.columns if 'region' in c), None)
    caspase_col = next((c for c in df.columns if 'caspase' in c), None)
    knockdown_col = next((c for c in df.columns if 'knockdown' in c or 
                          'mrna' in c or 'hif' in c), None)
    tm_col = next((c for c in df.columns if 'tm' in c or 'delta' in c), None)

    if not seq_col:
        print("ERROR: Could not find sequence column. Check Table S1 structure.")
        print(f"Available columns: {list(df.columns)}")
        sys.exit(1)

    rows = []
    for idx, row in df.iterrows():
        seq = str(row.get(seq_col, '')).strip().upper()
        if not seq or len(seq) < 10:
            continue

        design = str(row.get(design_col, '')) if design_col else ''
        region = str(row.get(region_col, 'unknown')) if region_col else 'unknown'
        caspase_pct = float(row[caspase_col]) if caspase_col and pd.notna(row[caspase_col]) else None
        knockdown_pct = float(row[knockdown_col]) if knockdown_col and pd.notna(row[knockdown_col]) else None
        delta_tm = float(row[tm_col]) if tm_col and pd.notna(row[tm_col]) else None

        lna_feats = parse_lna_design(design)

        # ── Binary endpoint labels ──────────────────────────────────────────
        if caspase_pct is not None:
            offtarget_silencing = int(caspase_pct > CASPASE_TOX_THRESHOLD)
            hepatocellular_injury = int(caspase_pct > CASPASE_SEVERE_THRESHOLD)
        else:
            offtarget_silencing = -1  # unknown
            hepatocellular_injury = -1

        out_row = {
            "oligo_id": f"PAPARGYRI_{region}_{idx:03d}",
            "modality": "ASO_gapmer",
            "sequence": seq,
            "length": len(seq),
            "gc_content": round(compute_gc(seq), 3),
            "cpg_density": round(compute_cpg(seq), 3),
            "ps_fraction": 1.0,  # all Papargyri gapmers are fully PS
            "lna_count": lna_feats["lna_count"],
            "lna_5prime": lna_feats["lna_5prime"],
            "lna_3prime": lna_feats["lna_3prime"],
            "moe_count": 0,
            "sugar_mod": "LNA",
            "backbone": "PS",
            "delivery": "naked",
            "route": "transfection_in_vitro",
            "dose_mg_kg": 0.1,
            "species": "HeLa_in_vitro",
            "target_gene": "HIF1A",
            "target_class": "coding_RNA",
            "has_galNAc": 0,
            "has_ps_backbone": 1,
            "seed_match_score": estimate_seed_match_score(seq),
            "rigi_mda5_risk": 0.05,  # PS-LNA, not dsRNA trigger
            "tlr789_prob": compute_tlr_prob(seq),
            "mfe_kcal_mol": delta_tm if delta_tm else -7.0,
            "conservation_phylop": 0.82,  # HIF1A is well conserved
            "caspase_pct_raw": caspase_pct,
            "knockdown_pct_raw": knockdown_pct,
            "papargyri_region": region,
            # ── 13 endpoint labels ──────────────────────────────────────
            "hepatocellular_injury": hepatocellular_injury,
            "renal_tubular_injury": 0,   # in vitro, not assessed
            "thrombocytopenia": 0,        # in vitro, not assessed
            "complement_activation": 0,   # in vitro, not assessed
            "cytokine_release": 0,        # in vitro, not assessed
            "innate_immune_activation": int(compute_tlr_prob(seq) > 0.3),
            "offtarget_gene_silencing": offtarget_silencing,
            "cns_neurotoxicity": -1,      # unknown
            "reproductive_developmental": -1,  # unknown
            "lncrna_network_disruption": 0,
            "micropeptide_codepletion": 0,
            "lnp_immune_effects": 0,
            "ps_backbone_effects": 1,     # all PS
            "study_source": "Papargyri_2020_TableS1",
            "notes": f"caspase={caspase_pct:.1f}%, knockdown={knockdown_pct:.1f}%" if caspase_pct else ""
        }
        rows.append(out_row)

    return pd.DataFrame(rows)


def main():
    parser = argparse.ArgumentParser(description="Convert Papargyri Table S1 to OligoTox CSV")
    parser.add_argument("--input", required=True, 
                        help="Path to Table S1 Excel file")
    parser.add_argument("--output", default="data/curated/papargyri_512gapmers_labeled.csv",
                        help="Output CSV path")
    parser.add_argument("--sheet", default=0, 
                        help="Sheet index or name in Excel file")
    args = parser.parse_args()

    print(f"Loading: {args.input}")
    try:
        df = pd.read_excel(args.input, sheet_name=args.sheet)
    except Exception as e:
        print(f"ERROR loading Excel: {e}")
        print("Try: pip install openpyxl xlrd")
        sys.exit(1)

    print(f"Raw table shape: {df.shape}")
    print(f"Columns: {list(df.columns[:10])} ...")

    out_df = process_table_s1(df)

    n_toxic = (out_df["offtarget_gene_silencing"] == 1).sum()
    n_safe = (out_df["offtarget_gene_silencing"] == 0).sum()

    out_df.to_csv(args.output, index=False)

    print(f"\n✓  Processed {len(out_df)} gapmers")
    print(f"   Caspase TOXIC (>300%): {n_toxic} ({100*n_toxic/len(out_df):.1f}%)")
    print(f"   Caspase SAFE (<=300%): {n_safe} ({100*n_safe/len(out_df):.1f}%)")
    print(f"   Saved to: {args.output}")
    print(f"\nNext steps:")
    print(f"  PYTHONPATH=$HOME python oligotox/scripts/curated_csv_to_training.py --input {args.output}")
    print(f"  PYTHONPATH=$HOME python oligotox/train.py")


if __name__ == "__main__":
    main()
