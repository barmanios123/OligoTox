        "ps_fraction": 1.0, "lna_count": 0, "moe_count": 10, "sugar_mod": "2MOE",
        "backbone": "PS", "delivery": "naked", "route": "IT",
        "has_galNAc": 0, "has_ps_backbone": 1,
        "target_gene": "SMN2", "target_class": "coding_RNA",
        "seed_match_score": 0.10, "rigi_mda5_risk": 0.04, "tlr789_prob": 0.05,
