        "length": 20, "gc_content": 0.55, "cpg_density": 0.05,
        "ps_fraction": 1.0, "lna_count": 0, "moe_count": 10, "sugar_mod": "2MOE",
        "backbone": "PS", "delivery": "naked", "route": "SC",
        "has_galNAc": 0, "has_ps_backbone": 1,
        "target_gene": "TTR", "target_class": "coding_RNA",
        "seed_match_score": 0.12, "rigi_mda5_risk": 0.05, "tlr789_prob": 0.08,
        "mfe_kcal_mol": -8.2, "conservation_phylop": 0.90,
        # Other endpoints from NDA
        "hepatocellular_injury": 1, "renal_tubular_injury": 1,
        "complement_activation": 0, "cytokine_release": 0,
        "innate_immune_activation": 0, "offtarget_gene_silencing": 0,
