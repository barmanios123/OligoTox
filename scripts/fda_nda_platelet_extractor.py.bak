def build_platelet_rows(drug_name):
    """Build OligoTox rows with platelet nadir data for a given drug."""
    if drug_name not in SEEDED_NDA_DATA:
        print(f"ERROR: Drug '{drug_name}' not in database. Options: {list(SEEDED_NDA_DATA.keys())}")
        sys.exit(1)

    feats = DRUG_FEATURES[drug_name]
    rows = []

    for entry in SEEDED_NDA_DATA[drug_name]:
        row = {
            "oligo_id": entry["oligo_id"],
            "modality": feats["modality"],
            "sequence": feats["sequence"],
            "length": feats["length"],
            "gc_content": feats["gc_content"],
            "cpg_density": feats["cpg_density"],
            "ps_fraction": feats["ps_fraction"],
            "lna_count": feats["lna_count"],
            "moe_count": feats["moe_count"],
            "sugar_mod": feats["sugar_mod"],
            "backbone": feats["backbone"],
            "delivery": feats["delivery"],
            "route": feats["route"],
            "dose_mg_kg": entry["dose_mg_kg"],
            "species": entry["species"],
            "timepoint_weeks": entry["timepoint_weeks"],
            "platelet_pct_baseline": entry["platelet_pct_baseline"],
            "target_gene": feats["target_gene"],
            "target_class": feats["target_class"],
            "has_galNAc": feats["has_galNAc"],
            "has_ps_backbone": feats["has_ps_backbone"],
            "seed_match_score": feats["seed_match_score"],
            "rigi_mda5_risk": feats["rigi_mda5_risk"],
            "tlr789_prob": feats["tlr789_prob"],
            "mfe_kcal_mol": feats["mfe_kcal_mol"],
            "conservation_phylop": feats["conservation_phylop"],
            # Endpoints
            "hepatocellular_injury": feats["hepatocellular_injury"],
            "renal_tubular_injury": feats["renal_tubular_injury"],
            "thrombocytopenia": entry["thrombocytopenia"],
            "complement_activation": feats["complement_activation"],
            "cytokine_release": feats["cytokine_release"],
            "innate_immune_activation": feats["innate_immune_activation"],
            "offtarget_gene_silencing": feats["offtarget_gene_silencing"],
            "cns_neurotoxicity": feats["cns_neurotoxicity"],
            "reproductive_developmental": feats["reproductive_developmental"],
            "lncrna_network_disruption": feats["lncrna_network_disruption"],
            "micropeptide_codepletion": feats["micropeptide_codepletion"],
            "lnp_immune_effects": feats["lnp_immune_effects"],
            "ps_backbone_effects": feats["ps_backbone_effects"],
            "study_source": f"FDA_NDA_{drug_name.upper()}",
            "notes": entry.get("notes", ""),
        }
        rows.append(row)

    return pd.DataFrame(rows)


def main():
    parser = argparse.ArgumentParser(description="Extract platelet data from FDA NDA reviews")
    parser.add_argument("--drug", choices=list(SEEDED_NDA_DATA.keys()), required=True)
    parser.add_argument("--pdf", help="Path to FDA NDA PharmR PDF (for reference)")
    parser.add_argument("--output", default=None, help="Output CSV path")
    parser.add_argument("--all", action="store_true", help="Process all drugs and merge")
    args = parser.parse_args()

    if args.all:
        all_dfs = []
        for drug in SEEDED_NDA_DATA.keys():
            df = build_platelet_rows(drug)
            all_dfs.append(df)
            print(f"  {drug}: {len(df)} rows, {df['thrombocytopenia'].sum()} thrombocytopenia positives")
        combined = pd.concat(all_dfs, ignore_index=True)
        output = args.output or "data/curated/fda_all_drugs_platelet_labeled.csv"
        combined.to_csv(output, index=False)
        print(f"\n✓  Combined: {len(combined)} rows saved to {output}")
        n_pos = combined["thrombocytopenia"].sum()
        print(f"   thrombocytopenia positives: {n_pos}/{len(combined)} ({100*n_pos/len(combined):.0f}%)")
        print(f"\n⚠  IMPORTANT: These are seeded PLACEHOLDER values.")
        print(f"   Extract exact platelet nadirs from the downloaded PDFs and update:")
        if args.pdf:
            print(f"   {args.pdf}")
        for drug_name in SEEDED_NDA_DATA.keys():
            print(f"   data/raw/fda_reviews/{drug_name}_NDA*_PharmR.pdf")
    else:
        df = build_platelet_rows(args.drug)
        output = args.output or f"data/curated/fda_{args.drug}_platelet_labeled.csv"
        df.to_csv(output, index=False)
        print(f"✓  {args.drug}: {len(df)} rows saved to {output}")
        if args.pdf:
            print(f"\n   Extract actual platelet values from: {args.pdf}")
            print(f"   Search for: 'platelet', 'thrombocytopenia', 'PLT count', Table [hematology]")
            print(f"   Update the SEEDED_NDA_DATA dict in this script with real values.")


if __name__ == "__main__":
    main()
