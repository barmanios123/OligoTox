        "Hepatotoxicity": "Primary human hepatocytes, ALT/AST release, mitochondrial stress panel.",
        "Nephrotoxicity": "Renal proximal tubule assay, KIM-1/NGAL biomarkers, uptake studies.",
        "Thrombocytopenia": "Platelet count monitoring, coagulation panel, hematology follow-up.",
        "Immune Activation": "PBMC cytokine panel, TLR reporter assays, innate immune profiling.",
        "Complement Activation": "C3a/C5a, CH50/AH50, complement follow-up.",
        "CARPA": "Serum complement panel and infusion reaction risk screen.",
        "Injection Site Reaction": "Local tolerance and inflammatory marker follow-up.",
        "Coagulation Liability": "PT/aPTT and thrombin generation studies.",
        "Innate Sensing": "TLR/RIG-I/MDA5 reporter panel.",
        "Off-Target Risk": "Transcriptome-wide off-target screen and mismatch sensitivity profiling.",
        "Renal Accumulation Risk": "Kidney exposure modeling and tissue distribution studies.",
        "Cytokine Release": "PBMC cytokine release assay and multiplex inflammatory panel.",
        "Hematology Signal": "CBC with differential and reticulocyte follow-up.",
        "Kupffer Cell Activation": "Liver macrophage activation follow-up and hepatic cytokine panel.",
    }
    if per_df.empty:
        return pd.DataFrame(columns=["Priority", "Endpoint", "Recommended Assays"])
    rows = []
    for i, (_, row) in enumerate(per_df.head(5).iterrows(), start=1):
        rows.append(
            {
                "Priority": i,
                "Endpoint": row["Endpoint"],
                "Recommended Assays": rules.get(row["Endpoint"], "General confirmatory nonclinical follow-up panel."),
            }
        )
    return pd.DataFrame(rows)


def default_report_markdown(payload: Dict[str, Any], result: Dict[str, Any], per_df: pd.DataFrame) -> str:
    dominant = result.get("dominant_endpoint", "n/a")
    composite = result.get("composite_score", "n/a")
    band = result.get("composite_band", "n/a")
    top_lines = []
    if not per_df.empty:
        for _, row in per_df.head(5).iterrows():
            top_lines.append(f"- {row['Endpoint']}: {row['Risk %']}% ({row['Confidence']})")
    return f"""# OligoTox Summary

## Candidate
- Sequence: `{payload.get('sequence', '')}`
- Modality: {payload.get('modality', 'n/a')}
- Chemistry: {payload.get('chemistry', 'n/a')}
- Conjugate: {payload.get('conjugate', 'n/a')}
- Route: {payload.get('route', 'n/a')}
- Dose (mg/kg): {payload.get('dose_mg_kg', 'n/a')}
- Schedule: {payload.get('schedule', 'n/a')}

## Composite Assessment
- Composite score: {composite}
- Composite band: {band}
- Dominant endpoint: {dominant}

## Highest Priority Signals
{chr(10).join(top_lines) if top_lines else "- No endpoint outputs available"}
"""


def compare_candidates(candidates: List[Dict[str, Any]]) -> pd.DataFrame:
    rows = []
    for cand in candidates:
        try:
            out = run_oligotox(cand)
            rows.append(
                {
                    "Candidate": cand.get("name", "Unnamed"),
                    "Sequence": cand.get("sequence", ""),
                    "Modality": cand.get("modality", ""),
                    "Chemistry": cand.get("chemistry", ""),
                    "Conjugate": cand.get("conjugate", ""),
                    "Composite Score": safe_float(out.get("composite_score", 0.0)),
                    "Composite Band": out.get("composite_band", ""),
                    "Dominant Endpoint": out.get("dominant_endpoint", ""),
                }
            )
        except Exception as e:
            rows.append(
                {
                    "Candidate": cand.get("name", "Unnamed"),
                    "Sequence": cand.get("sequence", ""),
                    "Modality": cand.get("modality", ""),
                    "Chemistry": cand.get("chemistry", ""),
                    "Conjugate": cand.get("conjugate", ""),
                    "Composite Score": math.nan,
                    "Composite Band": f"ERROR: {e}",
                    "Dominant Endpoint": "",
                }
            )
    df = pd.DataFrame(rows)
    if not df.empty:
        df = df.sort_values("Composite Score", ascending=True, na_position="last").reset_index(drop=True)
    return df


def list_model_artifacts() -> pd.DataFrame:
    rows = []
    if MODEL_ARTIFACTS_DIR.exists():
        for p in sorted(MODEL_ARTIFACTS_DIR.rglob("*")):
            if p.is_file():
                rows.append(
                    {
                        "Artifact": p.name,
                        "Size (KB)": round(p.stat().st_size / 1024, 2),
                        "Modified": datetime.fromtimestamp(p.stat().st_mtime).isoformat(timespec="seconds"),
                    }
                )
    return pd.DataFrame(rows)


def list_metric_artifacts() -> pd.DataFrame:
    rows = []
    if METRICS_ARTIFACTS_DIR.exists():
        for p in sorted(METRICS_ARTIFACTS_DIR.rglob("*")):
