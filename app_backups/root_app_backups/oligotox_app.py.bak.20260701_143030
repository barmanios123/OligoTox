            st.info("No metrics artifacts found.")
        else:
            st.dataframe(metrics_df, width="stretch", hide_index=True)

        validation_report = ROOT / "VALIDATION_REPORT.md"
        if validation_report.exists():
            st.text_area("Validation report preview", validation_report.read_text()[:6000], height=320)

    with tabs[2]:
        st.markdown("### Models")
        df = list_model_artifacts()
        if df.empty:
            st.warning("No model artifacts found.")
        else:
            st.dataframe(df, width="stretch", hide_index=True)

    with tabs[3]:
        st.markdown("### Predictions")
        payload = st.session_state.get("last_payload")
        result = st.session_state.get("last_result")
        per_df = st.session_state.get("last_per_df", pd.DataFrame())

        left, right = st.columns(2)
        with left:
            st.markdown("#### Last payload")
            st.json(payload if payload else {"status": "No payload yet"})
        with right:
            st.markdown("#### Last result")
            st.json(result if result else {"status": "No result yet"})

        if per_df is not None and not per_df.empty:
            st.markdown("#### Last endpoint table")
            st.dataframe(per_df, width="stretch", hide_index=True)

    with tabs[4]:
        st.markdown("### Runs")
        runs = get_runs(st)
        if runs:
            runs_df = pd.DataFrame(runs[::-1])
            st.dataframe(runs_df, width="stretch", hide_index=True)
            st.download_button(
                "Download run log",
                data=runs_df.to_csv(index=False).encode("utf-8"),
                file_name="oligotox_run_log.csv",
                mime="text/csv",
                width="stretch",
            )
        else:
            st.info("No runs logged yet.")

    with tabs[5]:
        st.markdown("### Curation")
        assay_rules = APP_DIR / "assay_rules.csv"
        comparator_template = APP_DIR / "comparator_template.csv"

        left, right = st.columns(2)
        with left:
            st.markdown("#### Assay rules")
            if assay_rules.exists():
                st.dataframe(pd.read_csv(assay_rules), width="stretch", hide_index=True)
            else:
                st.warning("app/assay_rules.csv not found.")

        with right:
            st.markdown("#### Comparator template")
            if comparator_template.exists():
                st.dataframe(pd.read_csv(comparator_template), width="stretch", hide_index=True)
            else:
                st.warning("app/comparator_template.csv not found.")
