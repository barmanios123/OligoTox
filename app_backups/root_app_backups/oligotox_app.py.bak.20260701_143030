def normalize_sequence(seq: str) -> str:
    if not seq:
        return ""
    seq = seq.upper().replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
    return seq.replace("T", "U")


def validate_sequence(seq: str) -> Tuple[bool, str]:
    if not seq:
        return False, "Please enter a sequence."
    allowed = set("ACGUN")
    bad = sorted(set(seq) - allowed)
    if bad:
        return False, f"Invalid characters: {', '.join(bad)}. Allowed: A, C, G, U, N."
    if len(seq) < 8:
        return False, "Please enter at least 8 nt."
    if len(seq) > 200:
        return False, "Please keep input at 200 nt or fewer."
    return True, ""


def gc_fraction(seq: str) -> float:
    return ((seq.count("G") + seq.count("C")) / len(seq)) if seq else 0.0


def cpg_count(seq: str) -> int:
    return sum(1 for i in range(len(seq) - 1) if seq[i:i+2] == "CG")


def confidence_label(v: float) -> str:
    for threshold, label in CONFIDENCE_BANDS:
        if v >= threshold:
            return label
    return "Exploratory"


def safe_float(v: Any, default: float = 0.0) -> float:
    try:
        if v is None:
            return default
        return float(v)
    except Exception:
        return default


def build_payload(
    sequence: str,
    modality: str,
    chemistry: str,
    conjugate: str,
    route: str,
    delivery_vehicle: str,
    dose_mg_kg: float,
    repeat_dose: bool,
    schedule: str,
) -> Dict[str, Any]:
    return {
        "sequence": normalize_sequence(sequence),
        "modality": modality,
        "chemistry": chemistry,
        "conjugate": conjugate,
        "route": route,
        "delivery_vehicle": delivery_vehicle,
        "dose_mg_kg": dose_mg_kg if dose_mg_kg > 0 else None,
        "repeat_dose": repeat_dose,
        "schedule": schedule or None,
    }


def normalize_per_endpoint(result: Dict[str, Any]) -> pd.DataFrame:
    per = result.get("per_endpoint", {})
    rows = []
    if isinstance(per, dict):
        for k, v in per.items():
            if isinstance(v, dict):
                score = safe_float(v.get("score", v.get("probability", v.get("risk", 0.0))))
                mech = v.get("mechanism", "")
                notes = v.get("notes", "")
            else:
                score = safe_float(v)
                mech = ""
                notes = ""
            rows.append(
                {
                    "Endpoint": ENDPOINT_LABELS.get(k, k.replace("_", " ").title()),
                    "Score": round(score, 4),
                    "Risk %": round(score * 100, 1),
                    "Confidence": confidence_label(score),
                    "Mechanism": mech,
                    "Notes": notes,
                }
            )
    df = pd.DataFrame(rows)
    if not df.empty:
        df = df.sort_values("Score", ascending=False).reset_index(drop=True)
    return df


def summarize_mechanistic_proxies(result: Dict[str, Any]) -> pd.DataFrame:
    prox = result.get("mechanistic_proxies", {})
    if not isinstance(prox, dict):
        return pd.DataFrame(columns=["Proxy", "Value"])
    return pd.DataFrame([{"Proxy": k.replace("_", " ").title(), "Value": v} for k, v in prox.items()])


def summarize_omics(result: Dict[str, Any]) -> pd.DataFrame:
    omics = result.get("omics", {})
    if not isinstance(omics, dict):
        return pd.DataFrame(columns=["Signal", "Value"])
    return pd.DataFrame([{"Signal": k.replace("_", " ").title(), "Value": v} for k, v in omics.items()])


def assay_recommendations(per_df: pd.DataFrame) -> pd.DataFrame:
