def normalize_sequence(seq: str) -> str:
    if not seq:
        return ""
    seq = seq.upper().replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
    return seq.replace("T", "U")


def validate_sequence(seq: str) -> Tuple[bool, str]:
    if not seq:
        return False, "Please enter a sequence."
    allowed = set("ACGUN")
    bad = sorted(set(seq) - allowed)
    if bad:
        return False, f"Invalid characters found: {', '.join(bad)}. Allowed alphabet: A, C, G, U, N."
    if len(seq) < 8:
        return False, "Sequence is too short for meaningful profiling. Please enter at least 8 nt."
    if len(seq) > 200:
        return False, "Sequence is too long for this UI path. Please enter 200 nt or fewer."
    return True, ""


def gc_fraction(seq: str) -> float:
    if not seq:
        return 0.0
    return (seq.count("G") + seq.count("C")) / max(len(seq), 1)


def cpg_count(seq: str) -> int:
    return sum(1 for i in range(len(seq) - 1) if seq[i : i + 2] == "CG")


def confidence_label(v: float) -> str:
    for threshold, label in CONFIDENCE_BANDS:
        if v >= threshold:
            return label
    return "Exploratory"


def safe_float(v: Any, default: float = 0.0) -> float:
    try:
        if v is None:
            return default
        return float(v)
    except Exception:
        return default


