def metrics_summary() -> Dict[str, Any]:
    metrics_file = METRICS_ARTIFACTS_DIR / "training_summary.json"
    out: Dict[str, Any] = {"exists": metrics_file.exists()}
    if metrics_file.exists():
        try:
            with open(metrics_file, "r") as f:
                out["payload"] = json.load(f)
        except Exception as e:
            out["error"] = str(e)
    return out


def normalize_per_endpoint(result: Dict[str, Any]) -> pd.DataFrame:
    per = result.get("per_endpoint", {})
    rows = []
    if isinstance(per, dict):
        for k, v in per.items():
            if isinstance(v, dict):
                score = safe_float(v.get("score", v.get("probability", v.get("risk", 0.0))))
                mech = v.get("mechanism", "")
                notes = v.get("notes", "")
            else:
                score = safe_float(v)
                mech = ""
                notes = ""
            rows.append(
                {
                    "Endpoint": ENDPOINT_LABELS.get(k, k.replace("_", " ").title()),
                    "Endpoint Key": k,
                    "Score": round(score, 4),
                    "Risk %": round(score * 100, 1),
                    "Confidence": confidence_label(score),
                    "Mechanism": mech,
                    "Notes": notes,
                }
            )
    df = pd.DataFrame(rows)
    if not df.empty:
        df = df.sort_values("Score", ascending=False).reset_index(drop=True)
    return df


def summarize_mechanistic_proxies(result: Dict[str, Any]) -> pd.DataFrame:
    prox = result.get("mechanistic_proxies", {})
    if not isinstance(prox, dict):
        return pd.DataFrame(columns=["Proxy", "Value"])
    return pd.DataFrame(
        [{"Proxy": k.replace("_", " ").title(), "Value": v} for k, v in prox.items()]
    )


def summarize_omics(result: Dict[str, Any]) -> pd.DataFrame:
    omics = result.get("omics", {})
    if not isinstance(omics, dict):
        return pd.DataFrame(columns=["Signal", "Value"])
    return pd.DataFrame(
        [{"Signal": k.replace("_", " ").title(), "Value": v} for k, v in omics.items()]
    )


def build_payload(
    sequence: str,
    modality: str,
    chemistry: str,
    conjugate: str,
    route: str,
    delivery_vehicle: str,
    dose_mg_kg: float,
    repeat_dose: bool,
    schedule: str,
) -> Dict[str, Any]:
    return {
        "sequence": normalize_sequence(sequence),
        "modality": modality,
        "chemistry": chemistry,
        "conjugate": conjugate,
        "route": route,
        "delivery_vehicle": delivery_vehicle,
        "dose_mg_kg": dose_mg_kg if dose_mg_kg > 0 else None,
        "repeat_dose": repeat_dose,
        "schedule": schedule or None,
    }


def default_report_markdown(payload: Dict[str, Any], result: Dict[str, Any], per_df: pd.DataFrame) -> str:
    dominant = result.get("dominant_endpoint", "n/a")
    composite = result.get("composite_score", "n/a")
    band = result.get("composite_band", "n/a")

    top_lines = []
    if not per_df.empty:
        for _, row in per_df.head(5).iterrows():
            top_lines.append(f"- {row['Endpoint']}: {row['Risk %']}% ({row['Confidence']})")

    return f"""# OligoTox Regulatory-Style Summary

## Candidate
- Sequence: `{payload.get('sequence', '')}`
- Modality: {payload.get('modality', 'n/a')}
- Chemistry: {payload.get('chemistry', 'n/a')}
- Conjugate: {payload.get('conjugate', 'n/a')}
- Route: {payload.get('route', 'n/a')}
- Dose (mg/kg): {payload.get('dose_mg_kg', 'n/a')}
- Schedule: {payload.get('schedule', 'n/a')}

## Composite Assessment
- Composite score: {composite}
- Composite band: {band}
- Dominant endpoint: {dominant}

## Highest Priority Endpoint Signals
{chr(10).join(top_lines) if top_lines else "- No endpoint outputs available"}

## Interpretation
This report is intended as a mechanism-aware screening summary for internal nonclinical prioritization.
Outputs should be interpreted together with chemistry class, modality context, PK/PD exposure assumptions, and follow-up assay evidence.

## Suggested Next Steps
- Review highest-risk endpoints and mechanistic proxies.
- Confirm exposure assumptions in the PK/PD Bridge module.
- Use Assays tab to select follow-up experiments.
- Compare against benchmark candidates in Comparator.
"""


def assay_recommendations(per_df: pd.DataFrame) -> pd.DataFrame:
    rules = {
        "Hepatotoxicity": "Primary human hepatocytes, ALT/AST release, mitochondrial stress, transcriptomic injury panel.",
        "Nephrotoxicity": "Renal proximal tubule cell viability, uptake/accumulation studies, KIM-1 and NGAL biomarkers.",
        "Thrombocytopenia": "Platelet count monitoring, coagulation panel, complement-linked hematology follow-up.",
        "Immune Activation": "PBMC cytokine panel, TLR reporter assays, innate immune stimulation profiling.",
        "Complement Activation": "C3a/C5a, CH50/AH50, CARPA-oriented complement follow-up.",
        "CARPA": "Ex vivo human serum complement panel, infusion reaction risk screen.",
        "Injection Site Reaction": "Local tolerance panel, histopathology, cytokine and inflammatory marker follow-up.",
        "Coagulation Liability": "PT/aPTT, thrombin generation, platelet interaction follow-up.",
        "Innate Sensing": "TLR/RIG-I/MDA5 reporter panel, interferon signaling follow-up.",
        "Off-Target Risk": "Transcriptome-wide hybridization/off-target screen, mismatch sensitivity profiling.",
        "Renal Accumulation Risk": "Kidney exposure modeling, uptake assays, tissue distribution follow-up.",
        "Cytokine Release": "PBMC cytokine release assay, multiplex inflammatory panel.",
        "Hematology Signal": "CBC with differential, reticulocytes, marrow-related follow-up as appropriate.",
    }
    if per_df.empty:
        return pd.DataFrame(columns=["Priority", "Endpoint", "Recommended Assays"])
    rows = []
    for i, (_, row) in enumerate(per_df.head(5).iterrows(), start=1):
        rows.append(
            {
                "Priority": i,
                "Endpoint": row["Endpoint"],
                "Recommended Assays": rules.get(row["Endpoint"], "General confirmatory nonclinical follow-up panel."),
            }
        )
    return pd.DataFrame(rows)


def compare_candidates(candidates: List[Dict[str, Any]]) -> pd.DataFrame:
    rows = []
    for cand in candidates:
        try:
            out = run_oligotox(cand)
            rows.append(
                {
                    "Candidate": cand.get("name", "Unnamed"),
                    "Sequence": cand.get("sequence", ""),
                    "Modality": cand.get("modality", ""),
                    "Chemistry": cand.get("chemistry", ""),
                    "Conjugate": cand.get("conjugate", ""),
                    "Composite Score": safe_float(out.get("composite_score", 0.0)),
                    "Composite Band": out.get("composite_band", ""),
                    "Dominant Endpoint": out.get("dominant_endpoint", ""),
                }
            )
        except Exception as e:
            rows.append(
                {
                    "Candidate": cand.get("name", "Unnamed"),
                    "Sequence": cand.get("sequence", ""),
                    "Modality": cand.get("modality", ""),
                    "Chemistry": cand.get("chemistry", ""),
                    "Conjugate": cand.get("conjugate", ""),
                    "Composite Score": math.nan,
                    "Composite Band": f"ERROR: {e}",
                    "Dominant Endpoint": "",
                }
            )
    df = pd.DataFrame(rows)
    if not df.empty and "Composite Score" in df.columns:
        df = df.sort_values("Composite Score", ascending=True, na_position="last").reset_index(drop=True)
    return df


