                "Download report markdown",
                data=md.encode("utf-8"),
                file_name="oligotox_regulatory_summary.md",
                mime="text/markdown",
                width="stretch",
            )

else:
    tabs = st.tabs(ADMIN_TABS)

    with tabs[0]:
        st.subheader("Overview")
        st.caption("Operational status, artifacts, and current platform footprint.")

        c1, c2, c3, c4 = st.columns(4)
        with c1:
            st.metric("Processed Data Ready", "Yes" if PROCESSED_DATA_DIR.exists() else "No")
        with c2:
            st.metric("Model Registry Ready", "Yes" if MODEL_ARTIFACTS_DIR.exists() else "No")
        with c3:
            st.metric("Metrics Ready", "Yes" if METRICS_ARTIFACTS_DIR.exists() else "No")
        with c4:
            st.metric("PK/PD Bridge", "Yes" if PKPD_AVAILABLE else "No")

        st.markdown("#### Metrics Summary")
        st.json(metrics_summary())

        st.markdown("#### Recent Runs")
        runs = get_runs(st)
        if runs:
            st.dataframe(pd.DataFrame(runs[::-1]), width="stretch", hide_index=True)
        else:
            st.info("No runs logged yet.")

    with tabs[1]:
        st.subheader("Evaluation")
        st.caption("Validation and summary artifacts available in the repository.")
        metrics_df = list_metric_artifacts()
        if metrics_df.empty:
            st.info("No metrics artifacts found.")
        else:
            st.dataframe(metrics_df, width="stretch", hide_index=True)

        validation_report = ROOT / "VALIDATION_REPORT.md"
        if validation_report.exists():
            st.success(f"Validation report found: {validation_report.name}")
            with open(validation_report, "r") as f:
                st.text_area("Validation report preview", f.read()[:6000], height=360)

    with tabs[2]:
        st.subheader("Models")
        st.caption("Model artifact inventory and registry-facing visibility.")
        df = list_model_artifacts()
        if df.empty:
            st.warning("No model artifacts were found.")
        else:
            st.dataframe(df, width="stretch", hide_index=True)

    with tabs[3]:
        st.subheader("Predictions")
        st.caption("Last prediction payload and output for debugging and QA.")

        payload = st.session_state.get("last_payload")
        result = st.session_state.get("last_result")
        per_df = st.session_state.get("last_per_df", pd.DataFrame())

        left, right = st.columns(2)
        with left:
            st.markdown("#### Last Payload")
            st.json(payload if payload else {"status": "No payload yet"})
        with right:
            st.markdown("#### Last Result")
            st.json(result if result else {"status": "No result yet"})

        if per_df is not None and not per_df.empty:
            st.markdown("#### Last Endpoint Table")
            st.dataframe(per_df, width="stretch", hide_index=True)

    with tabs[4]:
        st.subheader("Runs")
        st.caption("Session-level run history captured through UI interactions.")
        runs = get_runs(st)
        if runs:
            runs_df = pd.DataFrame(runs[::-1])
            st.dataframe(runs_df, width="stretch", hide_index=True)
            st.download_button(
                "Download run log CSV",
                data=runs_df.to_csv(index=False).encode("utf-8"),
                file_name="oligotox_run_log.csv",
                mime="text/csv",
                width="stretch",
            )
        else:
            st.info("No runs logged yet.")

    with tabs[5]:
        st.subheader("Curation")
        st.caption("Reference templates and app-side curation assets.")

        assay_rules = APP_DIR / "assay_rules.csv"
        comparator_template = APP_DIR / "comparator_template.csv"

        left, right = st.columns(2)
        with left:
            st.markdown("#### Assay Rules")
            if assay_rules.exists():
                df = pd.read_csv(assay_rules)
                st.dataframe(df, width="stretch", hide_index=True)
            else:
                st.warning("app/assay_rules.csv not found.")

        with right:
            st.markdown("#### Comparator Template")
            if comparator_template.exists():
                df = pd.read_csv(comparator_template)
                st.dataframe(df, width="stretch", hide_index=True)
            else:
                st.warning("app/comparator_template.csv not found.")

st.divider()
st.caption(
    "OligoTox customer view focuses on candidate analysis, comparison, PK/PD interpretation, assay planning, "
    "and report generation. Admin view preserves internal operational visibility without crowding the user experience."
)