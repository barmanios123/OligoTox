# ============================================================================
# 2. DATA LOADING
# ============================================================================
test_section("2. Data Loading & Model Artifacts")

try:
    processed_dir = Path("data/processed")
    model_dir = Path("artifacts/models")
    config_dir = Path("artifacts/config")
    
    if not processed_dir.exists():
        test_failed("Data directory missing", "data/processed not found")
        results["failed"] += 1
    else:
        test_passed("Data directory exists")
        results["passed"] += 1
    
    if not model_dir.exists():
        test_warning("Model artifacts directory missing (expected if not trained)")
        results["warnings"] += 1
    else:
        model_files = list(model_dir.glob("*.joblib"))
        if len(model_files) > 0:
            test_passed(f"Found {len(model_files)} trained models")
            results["passed"] += 1
