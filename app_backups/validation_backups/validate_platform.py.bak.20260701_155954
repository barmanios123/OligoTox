def test_section(name):
    print(f"\n{'='*80}")
    print(f"Testing: {name}")
    print("="*80)

def test_passed(msg):
    print(f"✅ PASS: {msg}")

def test_failed(msg, error=None):
    print(f"❌ FAIL: {msg}")
    if error:
        print(f"   Error: {error}")
    return False

def test_warning(msg):
    print(f"⚠️  WARN: {msg}")

# Track results
results = {"passed": 0, "failed": 0, "warnings": 0}

